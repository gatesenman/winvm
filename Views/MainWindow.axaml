<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WinVM.ViewModels"
        xmlns:m="using:WinVM.Models"
        xmlns:c="using:WinVM.Controls"
        x:Class="WinVM.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="WinVM - Hyper-V 虚拟机管理器"
        Icon="/Assets/winvm.ico"
        Width="1180" Height="740" MinWidth="880" MinHeight="540"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding RefreshCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding RenameCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding OpenConsoleCommand}" />
    <!-- 1.5: power actions use Ctrl+Shift (never Ctrl+S/Ctrl+W) and act only on this focused window's selected VM -->
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding ShortcutPowerCommand}" CommandParameter="start" />
    <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding ShortcutPowerCommand}" CommandParameter="stop" />
    <KeyBinding Gesture="Ctrl+Shift+K" Command="{Binding ShortcutPowerCommand}" CommandParameter="turnoff" />
    <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding ShortcutPowerCommand}" CommandParameter="pause" />
    <KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding ShortcutPowerCommand}" CommandParameter="restart" />
    <KeyBinding Gesture="Ctrl+Shift+A" Command="{Binding EditAdvancedSettingsCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding CreateCheckpointCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding OneClickInstallCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+I" Command="{Binding ImportCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding CloneCommand}" />
    <KeyBinding Gesture="Ctrl+G" Command="{Binding ShowImageGalleryCommand}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding ShowPreferencesCommand}" />
    <KeyBinding Gesture="F1" Command="{Binding ShowShortcutsCommand}" />
    <KeyBinding Gesture="Ctrl+Q" Command="{Binding ExitCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <!-- ============ Menu bar ============ -->
    <Menu DockPanel.Dock="Top" Classes="bar">
      <MenuItem Header="文件(_F)">
        <MenuItem Header="新建虚拟机(_N)…" Command="{Binding CreateCommand}" InputGesture="Ctrl+N">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Add}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="一键安装系统(_I)…" Command="{Binding OneClickInstallCommand}" InputGesture="Ctrl+I">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Download}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="系统镜像库(_G)…" Command="{Binding ShowImageGalleryCommand}" InputGesture="Ctrl+G">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Disc}" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="导入虚拟机(_I)…" Command="{Binding ImportCommand}" InputGesture="Ctrl+Shift+I">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Import}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="导出虚拟机(_E)…" Command="{Binding ExportCommand}" InputGesture="Ctrl+E">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Export}" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="刷新(_R)" Command="{Binding RefreshCommand}" InputGesture="F5">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Refresh}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="打开虚拟机存储文件夹(_O)" Command="{Binding OpenStoreFolderCommand}">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Folder}" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="偏好设置(_P)…" Command="{Binding ShowPreferencesCommand}" InputGesture="Ctrl+OemComma">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Settings}" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="退出(_X)" Command="{Binding ExitCommand}" InputGesture="Ctrl+Q" />
      </MenuItem>
      <MenuItem Header="虚拟机(_V)">
        <MenuItem Header="连接(_C)">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Console}" /></MenuItem.Icon>
          <MenuItem Header="控制台 / Enhanced Session" Command="{Binding OpenConsoleCommand}" InputGesture="Ctrl+Enter">
            <MenuItem.Icon><c:IconView Data="{StaticResource I.Console}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="远程桌面 (RDP)" Command="{Binding OpenRdpCommand}">
            <MenuItem.Icon><c:IconView Data="{StaticResource I.Console}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="SSH" Command="{Binding OpenSshCommand}">
            <MenuItem.Icon><c:IconView Data="{StaticResource I.Console}" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="复制连接信息" Command="{Binding CopyConnectInfoCommand}" />
        </MenuItem>
        <Separator />
        <MenuItem Header="启动(_S)" Command="{Binding StartCommand}" InputGesture="Ctrl+Shift+S">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Play}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="关机(_D)…" Command="{Binding StopCommand}" InputGesture="Ctrl+Shift+T">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Power}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="强制关闭(_F)…" Command="{Binding TurnOffCommand}" InputGesture="Ctrl+Shift+K">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Bolt}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="暂停(_P)" Command="{Binding PauseCommand}" InputGesture="Ctrl+Shift+P">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Pause}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="恢复(_U)" Command="{Binding ResumeCommand}" InputGesture="Ctrl+Shift+P">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Play}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="重启(_E)…" Command="{Binding RestartCommand}" InputGesture="Ctrl+Shift+R">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Restart}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="重置（硬重启）…" Command="{Binding ResetCommand}">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Reset}" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="创建检查点(_K)…" Command="{Binding CreateCheckpointCommand}" InputGesture="Ctrl+T">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Checkpoint}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="设置(_G)…" Command="{Binding EditSettingsCommand}">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Settings}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="高级设置(_A)…" Command="{Binding EditAdvancedSettingsCommand}" InputGesture="Ctrl+Shift+A">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Settings}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="重命名(_M)…" Command="{Binding RenameCommand}" InputGesture="F2">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Rename}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="扩容磁盘(_Z)…" Command="{Binding ResizeDiskCommand}">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Disk}" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="克隆(_O)…" Command="{Binding CloneCommand}" InputGesture="Ctrl+D">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Clone}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="导出(_X)…" Command="{Binding ExportCommand}" InputGesture="Ctrl+E">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Export}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="在资源管理器中打开(_L)" Command="{Binding OpenVmFolderCommand}">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Folder}" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="虚拟交换机管理(_W)…" Command="{Binding ShowSwitchManagerCommand}">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Network}" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="删除(_R)…" Command="{Binding DeleteCommand}">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Delete}" /></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="查看(_W)">
        <MenuItem Header="按名称排序" ToggleType="Radio" GroupName="sort" IsChecked="{Binding IsSortByName, Mode=OneWay}"
                  Command="{Binding SetSortCommand}" CommandParameter="name" />
        <MenuItem Header="按状态排序" ToggleType="Radio" GroupName="sort" IsChecked="{Binding IsSortByState, Mode=OneWay}"
                  Command="{Binding SetSortCommand}" CommandParameter="state" />
        <Separator />
        <MenuItem Header="主题">
          <MenuItem Header="跟随系统" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsThemeSystem, Mode=OneWay}"
                    Command="{Binding SetThemeCommand}" CommandParameter="system" />
          <MenuItem Header="浅色" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsThemeLight, Mode=OneWay}"
                    Command="{Binding SetThemeCommand}" CommandParameter="light" />
          <MenuItem Header="深色" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsThemeDark, Mode=OneWay}"
                    Command="{Binding SetThemeCommand}" CommandParameter="dark" />
        </MenuItem>
        <Separator />
        <MenuItem Header="刷新" Command="{Binding RefreshCommand}" InputGesture="F5" />
      </MenuItem>
      <MenuItem Header="帮助(_H)">
        <MenuItem Header="键盘快捷键(_K)" Command="{Binding ShowShortcutsCommand}" InputGesture="F1">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Keyboard}" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="打开日志文件夹" Command="{Binding OpenLogFolderCommand}">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Folder}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="复制启用 Hyper-V 的命令" Command="{Binding CopyEnableCommandCommand}">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Copy}" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="关于 WinVM(_A)" Command="{Binding ShowAboutCommand}">
          <MenuItem.Icon><c:IconView Data="{StaticResource I.Info}" /></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
    </Menu>

    <!-- ============ Command bar ============ -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource App.Chrome}"
            BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" Padding="6,3">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="1">
          <Button Classes="tool" Command="{Binding CreateCommand}" ToolTip.Tip="新建虚拟机 (Ctrl+N)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Data="{StaticResource I.Add}" Foreground="{DynamicResource App.Accent}" StrokeThickness="2" />
              <TextBlock Text="新建" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding OneClickInstallCommand}" ToolTip.Tip="一键安装系统：下载官方 ISO 并创建虚拟机 (Ctrl+I)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Data="{StaticResource I.Download}" Foreground="{DynamicResource App.Accent}" StrokeThickness="2" />
              <TextBlock Text="一键安装" />
            </StackPanel>
          </Button>
          <Rectangle Classes="vsep" />
          <Button Classes="tool" Command="{Binding StartCommand}" ToolTip.Tip="启动虚拟机">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Data="{StaticResource F.Play}" Filled="True" Foreground="{StaticResource Dot.Running}" />
              <TextBlock Text="启动" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding StopCommand}" ToolTip.Tip="来宾正常关机">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Data="{StaticResource I.Power}" />
              <TextBlock Text="关机" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding TurnOffCommand}" ToolTip.Tip="立即断电（数据可能丢失）">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Data="{StaticResource I.Bolt}" Foreground="{DynamicResource App.Danger}" />
              <TextBlock Text="强制关闭" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding PauseCommand}" ToolTip.Tip="暂停虚拟机"
                  IsVisible="{Binding !SelectedVm.CanResume, FallbackValue=True}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Data="{StaticResource I.Pause}" Foreground="{StaticResource Dot.Paused}" StrokeThickness="2.2" />
              <TextBlock Text="暂停" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding ResumeCommand}" ToolTip.Tip="恢复已暂停的虚拟机"
                  IsVisible="{Binding SelectedVm.CanResume, FallbackValue=False}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Data="{StaticResource F.Play}" Filled="True" Foreground="{StaticResource Dot.Running}" />
              <TextBlock Text="恢复" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding RestartCommand}" ToolTip.Tip="来宾正常重启">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Data="{StaticResource I.Restart}" />
              <TextBlock Text="重启" />
            </StackPanel>
          </Button>
          <Rectangle Classes="vsep" />
          <Button Classes="tool" ToolTip.Tip="连接：控制台 / RDP / SSH">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="控制台 / Enhanced Session" Command="{Binding OpenConsoleCommand}" InputGesture="Ctrl+Enter" />
                <MenuItem Header="远程桌面 (RDP)" Command="{Binding OpenRdpCommand}" />
                <MenuItem Header="SSH" Command="{Binding OpenSshCommand}" />
                <Separator />
                <MenuItem Header="复制连接信息" Command="{Binding CopyConnectInfoCommand}" />
              </MenuFlyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Data="{StaticResource I.Console}" />
              <TextBlock Text="连接" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding CreateCheckpointCommand}" ToolTip.Tip="创建检查点 (Ctrl+T)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Data="{StaticResource I.Checkpoint}" />
              <TextBlock Text="检查点" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding CloneCommand}" ToolTip.Tip="克隆虚拟机（需关机，Ctrl+D）">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Data="{StaticResource I.Clone}" />
              <TextBlock Text="克隆" />
            </StackPanel>
          </Button>
          <Rectangle Classes="vsep" />
          <Button Classes="tool" Command="{Binding EditSettingsCommand}" ToolTip.Tip="虚拟机设置（需关机）">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Data="{StaticResource I.Settings}" />
              <TextBlock Text="设置" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding DeleteCommand}" ToolTip.Tip="删除虚拟机">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Data="{StaticResource I.Delete}" />
              <TextBlock Text="删除" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="1">
          <Button Classes="tool" Command="{Binding ShowImageGalleryCommand}" ToolTip.Tip="系统镜像库：下载官方镜像并一键安装 (Ctrl+G)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Data="{StaticResource I.Disc}" />
              <TextBlock Text="镜像库" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding RefreshCommand}" ToolTip.Tip="刷新 (F5)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Data="{StaticResource I.Refresh}" />
              <TextBlock Text="刷新" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Status bar ============ -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource App.StatusBar}"
            BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Height="28" Padding="12,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Classes="dot" Classes.running="{Binding IsHyperVOk}" Classes.bad="{Binding IsHyperVBad}" Width="8" Height="8" VerticalAlignment="Center" />
          <TextBlock Text="{Binding HyperVStatusText}" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Rectangle Classes="vsep" Height="14" Margin="12,0" />
          <TextBlock Text="{Binding VmCountText}" FontSize="12" VerticalAlignment="Center" />
          <Rectangle Classes="vsep" Height="14" Margin="12,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <ProgressBar IsIndeterminate="True" Width="70" MinWidth="70" Height="3" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
          <TextBlock Text="{Binding StatusMessage}" FontSize="12" Classes="caption" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="3" x:Name="TasksButton" Classes="tool small" IsVisible="{Binding HasTasks}" Margin="8,0,0,0" Padding="8,1" MinHeight="22"
                AutomationProperties.Name="后台任务" ToolTip.Tip="查看后台任务">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ProgressBar IsIndeterminate="True" Width="36" MinWidth="36" Height="3" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TasksSummaryText}" FontSize="12" VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedRight">
              <StackPanel Width="380" Spacing="10" Margin="4">
                <TextBlock Text="后台任务" Classes="section" />
                <ItemsControl ItemsSource="{Binding Tasks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:BackgroundTaskItem">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Height="4" MinWidth="0" />
                          <TextBlock Text="{Binding Detail}" Classes="caption" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="tool small" Margin="8,0,0,0" VerticalAlignment="Top" Command="{Binding CancelCommand}"
                                IsVisible="{Binding CanCancel}" IsEnabled="{Binding !IsCancelling}" AutomationProperties.Name="取消任务" ToolTip.Tip="取消">
                          <c:IconView Data="{StaticResource I.Close}" Width="12" Height="12" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <TextBlock Grid.Column="4" Text="{Binding LastRefreshText}" FontSize="12" Classes="caption" VerticalAlignment="Center" Margin="12,0" />
        <TextBlock Grid.Column="5" Text="{Binding VersionText}" FontSize="12" Classes="caption" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- ============ Content ============ -->
    <Panel>
      <!-- Toasts (bottom-right overlay) -->
      <ItemsControl ItemsSource="{Binding Toasts}" ZIndex="100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,14"
                    Width="360" AutomationProperties.Name="通知">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:ToastItem">
            <Border Classes="toast" Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}" Classes.success="{Binding IsSuccess}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Panel Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,10,0">
                  <c:IconView Data="{StaticResource I.Check}" Width="18" Height="18" StrokeThickness="2.2" Foreground="{StaticResource Dot.Running}" IsVisible="{Binding IsSuccess}" />
                  <c:IconView Data="{StaticResource I.Info}" Width="18" Height="18" Foreground="{DynamicResource App.Accent}" IsVisible="{Binding IsInfo}" />
                  <c:IconView Data="{StaticResource I.Warning}" Width="18" Height="18" Foreground="#D18A00" IsVisible="{Binding IsWarning}" />
                  <c:IconView Data="{StaticResource I.Warning}" Width="18" Height="18" Foreground="{DynamicResource App.Danger}" IsVisible="{Binding IsError}" />
                </Panel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Message}" Classes="caption" TextWrapping="Wrap" MaxHeight="64" IsVisible="{Binding HasMessage}" />
                  <Button Classes="link" Content="{Binding ActionText}" Command="{Binding RunActionCommand}" IsVisible="{Binding HasAction}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Classes="tool small" VerticalAlignment="Top" Margin="6,-2,-4,0" Padding="5" MinHeight="0"
                        Command="{Binding CloseCommand}" AutomationProperties.Name="关闭通知" ToolTip.Tip="关闭">
                  <c:IconView Data="{StaticResource I.Close}" Width="10" Height="10" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Checking -->
      <StackPanel IsVisible="{Binding ShowChecking}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
        <ProgressBar IsIndeterminate="True" Width="220" Height="4" />
        <TextBlock Text="正在检测 Hyper-V…" HorizontalAlignment="Center" Classes="caption" />
      </StackPanel>

      <!-- Hyper-V unavailable -->
      <ScrollViewer IsVisible="{Binding ShowUnavailable}">
        <Border Classes="group" MaxWidth="720" Margin="32" Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource Warn.Background}">
                <c:IconView Data="{StaticResource I.Warning}" Width="26" Height="26" Foreground="#D18A00" StrokeThickness="1.8" />
              </Border>
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Hyper-V 不可用" Classes="h1" />
                <TextBlock Text="WinVM 需要本机的 Hyper-V 才能管理虚拟机。" Classes="caption" />
              </StackPanel>
            </StackPanel>
            <Border Classes="warn">
              <SelectableTextBlock Text="{Binding HyperVReasonText}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="解决方法" Classes="section" />
            <SelectableTextBlock Text="{Binding HyperVGuidance}" TextWrapping="Wrap" LineHeight="21" Classes="v" />
            <WrapPanel Orientation="Horizontal">
              <Button Classes="accent" Margin="0,0,8,8" Command="{Binding RelaunchAsAdminCommand}" IsVisible="{Binding CanRelaunchAsAdmin}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:IconView Data="{StaticResource I.Shield}" />
                  <TextBlock Text="以管理员身份重新启动" />
                </StackPanel>
              </Button>
              <Button Margin="0,0,8,8" Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:IconView Data="{StaticResource I.Refresh}" />
                  <TextBlock Text="重新检测" />
                </StackPanel>
              </Button>
              <Button Margin="0,0,8,8" Command="{Binding CopyEnableCommandCommand}" IsVisible="{Binding ShowEnableCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:IconView Data="{StaticResource I.Copy}" />
                  <TextBlock Text="复制启用命令" />
                </StackPanel>
              </Button>
              <Button Margin="0,0,8,8" Command="{Binding OpenLogFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:IconView Data="{StaticResource I.Folder}" />
                  <TextBlock Text="打开日志" />
                </StackPanel>
              </Button>
            </WrapPanel>
            <CheckBox Content="以后启动时自动请求管理员权限" IsChecked="{Binding AutoElevate}" IsVisible="{Binding CanRelaunchAsAdmin}" />
          </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- Library: sidebar | splitter | details -->
      <Grid x:Name="SplitGrid" IsVisible="{Binding ShowLibrary}" ColumnDefinitions="290,Auto,*">
        <Border Background="{DynamicResource App.Sidebar}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,1,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="12,12,12,6" Spacing="10">
              <TextBox x:Name="SearchBox" Text="{Binding SearchText}" Watermark="搜索名称、状态、系统… (Ctrl+F)" AutomationProperties.Name="搜索虚拟机">
                <TextBox.InnerLeftContent>
                  <c:IconView Data="{StaticResource I.Search}" Margin="8,0,0,0" Width="14" Height="14" Foreground="{DynamicResource App.SubText}" />
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                  <Button Classes="tool small" Command="{Binding ClearSearchCommand}" Padding="5" MinHeight="0" Margin="0,0,2,0"
                          IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" ToolTip.Tip="清除" AutomationProperties.Name="清除搜索">
                    <c:IconView Data="{StaticResource I.Close}" Width="10" Height="10" />
                  </Button>
                </TextBox.InnerRightContent>
              </TextBox>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding LibraryHeader}" Classes="caption" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
                <Button Grid.Column="1" Classes="tool small" ToolTip.Tip="排序方式">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="排序" FontSize="12" />
                    <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center" />
                  </StackPanel>
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="按名称" ToggleType="Radio" GroupName="sort2" IsChecked="{Binding IsSortByName, Mode=OneWay}"
                                Command="{Binding SetSortCommand}" CommandParameter="name" />
                      <MenuItem Header="按状态" ToggleType="Radio" GroupName="sort2" IsChecked="{Binding IsSortByState, Mode=OneWay}"
                                Command="{Binding SetSortCommand}" CommandParameter="state" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </StackPanel>
            <Panel>
              <ListBox x:Name="VmList" Classes="vmlist" ItemsSource="{Binding FilteredVms}" SelectedItem="{Binding SelectedVm}" AutomationProperties.Name="虚拟机列表"
                       DoubleTapped="OnVmListDoubleTapped">
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="连接">
                      <MenuItem.Icon><c:IconView Data="{StaticResource I.Console}" /></MenuItem.Icon>
                      <MenuItem Header="控制台 / Enhanced Session" Command="{Binding OpenConsoleCommand}" InputGesture="Ctrl+Enter" />
                      <MenuItem Header="远程桌面 (RDP)" Command="{Binding OpenRdpCommand}" />
                      <MenuItem Header="SSH" Command="{Binding OpenSshCommand}" />
                      <Separator />
                      <MenuItem Header="复制连接信息" Command="{Binding CopyConnectInfoCommand}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="启动" Command="{Binding StartCommand}" InputGesture="Ctrl+Shift+S">
                      <MenuItem.Icon><c:IconView Data="{StaticResource I.Play}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="关机…" Command="{Binding StopCommand}" InputGesture="Ctrl+Shift+T">
                      <MenuItem.Icon><c:IconView Data="{StaticResource I.Power}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="强制关闭…" Command="{Binding TurnOffCommand}" InputGesture="Ctrl+Shift+K">
                      <MenuItem.Icon><c:IconView Data="{StaticResource I.Bolt}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="暂停" Command="{Binding PauseCommand}" InputGesture="Ctrl+Shift+P">
                      <MenuItem.Icon><c:IconView Data="{StaticResource I.Pause}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="恢复" Command="{Binding ResumeCommand}" InputGesture="Ctrl+Shift+P">
                      <MenuItem.Icon><c:IconView Data="{StaticResource I.Play}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="重启…" Command="{Binding RestartCommand}" InputGesture="Ctrl+Shift+R">
                      <MenuItem.Icon><c:IconView Data="{StaticResource I.Restart}" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="创建检查点…" Command="{Binding CreateCheckpointCommand}" InputGesture="Ctrl+T">
                      <MenuItem.Icon><c:IconView Data="{StaticResource I.Checkpoint}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="设置…" Command="{Binding EditSettingsCommand}">
                      <MenuItem.Icon><c:IconView Data="{StaticResource I.Settings}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="高级设置…" Command="{Binding EditAdvancedSettingsCommand}" InputGesture="Ctrl+Shift+A">
                      <MenuItem.Icon><c:IconView Data="{StaticResource I.Settings}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="重命名…" Command="{Binding RenameCommand}" InputGesture="F2">
                      <MenuItem.Icon><c:IconView Data="{StaticResource I.Rename}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="扩容磁盘…" Command="{Binding ResizeDiskCommand}">
                      <MenuItem.Icon><c:IconView Data="{StaticResource I.Disk}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="在资源管理器中打开" Command="{Binding OpenVmFolderCommand}">
                      <MenuItem.Icon><c:IconView Data="{StaticResource I.Folder}" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="克隆…" Command="{Binding CloneCommand}" InputGesture="Ctrl+D">
                      <MenuItem.Icon><c:IconView Data="{StaticResource I.Clone}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="导出…" Command="{Binding ExportCommand}" InputGesture="Ctrl+E">
                      <MenuItem.Icon><c:IconView Data="{StaticResource I.Export}" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="删除…" Command="{Binding DeleteCommand}">
                      <MenuItem.Icon><c:IconView Data="{StaticResource I.Delete}" /></MenuItem.Icon>
                    </MenuItem>
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="m:VmInfo">
                    <Grid ColumnDefinitions="Auto,Auto,*" Height="42">
                      <Border Classes="pill" Width="3" Height="18" CornerRadius="2" Margin="-6,0,5,0"
                              Background="{DynamicResource App.Accent}" VerticalAlignment="Center" />
                      <Panel Grid.Column="1" Width="32" Height="32">
                        <Border Classes="os" Classes.windows="{Binding IsWindowsOs}" Classes.linux="{Binding IsLinuxOs}"
                                CornerRadius="7" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top">
                          <Panel>
                            <c:IconView Data="{StaticResource F.Windows}" Width="16" Height="16" IsVisible="{Binding IsWindowsOs}" />
                            <c:IconView Data="{StaticResource F.Linux}" Width="18" Height="18" IsVisible="{Binding IsLinuxOs}" />
                            <c:IconView Data="{StaticResource F.Monitor}" Width="17" Height="17" IsVisible="{Binding IsUnknownOs}" />
                          </Panel>
                        </Border>
                        <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource App.Sidebar}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                          <Ellipse Classes="dot" Width="8" Height="8"
                                   Classes.running="{Binding IsRunningChip}" Classes.paused="{Binding IsPausedChip}"
                                   Classes.saved="{Binding IsSavedChip}" Classes.transient="{Binding IsTransientChip}" />
                        </Border>
                      </Panel>
                      <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ListSubtitle}" Classes="caption" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="没有匹配的虚拟机" Classes="caption" HorizontalAlignment="Center" Margin="0,24,0,0"
                         IsVisible="{Binding HasNoSearchResults}" />
            </Panel>
          </DockPanel>
        </Border>

        <GridSplitter x:Name="Splitter" Grid.Column="1" Classes="split" ResizeDirection="Columns" />

        <!-- Detail pane -->
        <Panel Grid.Column="2">
          <!-- Empty library -->
          <StackPanel IsVisible="{Binding ShowEmptyLibrary}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="380">
            <c:IconView Data="{StaticResource I.Monitor}" Width="64" Height="64" StrokeThickness="1.2" Foreground="{DynamicResource App.SubText}" HorizontalAlignment="Center" />
            <TextBlock Text="还没有虚拟机" Classes="h2" HorizontalAlignment="Center" />
            <TextBlock Text="一键下载官方 Linux / Windows ISO 并创建虚拟机，或手动新建。macOS 因许可与 Hyper-V 限制不可用。虚拟磁盘默认保存在 %USERPROFILE%\WinVM\Machines。"
                       Classes="caption" TextWrapping="Wrap" TextAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
              <Button Classes="accent" Command="{Binding OneClickInstallCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:IconView Data="{StaticResource I.Download}" StrokeThickness="2" />
                  <TextBlock Text="一键安装系统" />
                </StackPanel>
              </Button>
              <Button Command="{Binding CreateCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:IconView Data="{StaticResource I.Add}" StrokeThickness="2" />
                  <TextBlock Text="新建虚拟机" />
                </StackPanel>
              </Button>
              <Button Command="{Binding ShowImageGalleryCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:IconView Data="{StaticResource I.Disc}" />
                  <TextBlock Text="浏览系统镜像" />
                </StackPanel>
              </Button>
              <Button Command="{Binding ImportCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:IconView Data="{StaticResource I.Import}" />
                  <TextBlock Text="导入" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>

          <!-- No selection -->
          <StackPanel IsVisible="{Binding ShowNoSelection}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <c:IconView Data="{StaticResource I.Monitor}" Width="56" Height="56" StrokeThickness="1.2" Foreground="{DynamicResource App.SubText}" HorizontalAlignment="Center" />
            <TextBlock Text="未选择虚拟机" Classes="h2" HorizontalAlignment="Center" />
            <TextBlock Text="在左侧列表中选择一台虚拟机以查看详细信息。" Classes="caption" HorizontalAlignment="Center" />
          </StackPanel>

          <!-- Details -->
          <ScrollViewer IsVisible="{Binding ShowDetail}" Padding="28,22,28,10">
            <StackPanel DataContext="{Binding SelectedVm}" x:DataType="m:VmInfo" Spacing="0" MaxWidth="980" HorizontalAlignment="Stretch">
              <!-- Header -->
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,18">
                <Border Classes="os" Classes.windows="{Binding IsWindowsOs}" Classes.linux="{Binding IsLinuxOs}"
                        CornerRadius="12" Width="56" Height="56" VerticalAlignment="Center">
                  <Panel>
                    <c:IconView Data="{StaticResource F.Windows}" Width="28" Height="28" IsVisible="{Binding IsWindowsOs}" />
                    <c:IconView Data="{StaticResource F.Linux}" Width="32" Height="32" IsVisible="{Binding IsLinuxOs}" />
                    <c:IconView Data="{StaticResource F.Monitor}" Width="30" Height="30" IsVisible="{Binding IsUnknownOs}" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center" Spacing="6">
                  <SelectableTextBlock Text="{Binding Name}" Classes="h1" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="chip" Classes.running="{Binding IsRunningChip}" Classes.paused="{Binding IsPausedChip}" Classes.saved="{Binding IsSavedChip}">
                      <TextBlock Text="{Binding StateText}" />
                    </Border>
                    <TextBlock Text="{Binding SpecsLine}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="accent" MinHeight="34" Padding="18,6"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).StartCommand}" IsVisible="{Binding CanStart}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <c:IconView Data="{StaticResource F.Play}" Filled="True" Width="14" Height="14" />
                      <TextBlock Text="启动" FontWeight="SemiBold" />
                    </StackPanel>
                  </Button>
                  <Button Classes="accent" MinHeight="34" Padding="18,6"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ResumeCommand}" IsVisible="{Binding CanResume}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <c:IconView Data="{StaticResource F.Play}" Filled="True" Width="14" Height="14" />
                      <TextBlock Text="恢复" FontWeight="SemiBold" />
                    </StackPanel>
                  </Button>
                  <Button MinHeight="34" Padding="14,6"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).StopCommand}" IsVisible="{Binding CanStop}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <c:IconView Data="{StaticResource I.Power}" />
                      <TextBlock Text="关机" />
                    </StackPanel>
                  </Button>
                  <Button MinHeight="34" Padding="14,6" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenConsoleCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <c:IconView Data="{StaticResource I.Console}" />
                      <TextBlock Text="控制台" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>

              <!-- Background task on this VM -->
              <Border Classes="warn" Margin="0,0,0,12" DataContext="{Binding $parent[Window].DataContext}" x:DataType="vm:MainViewModel"
                      IsVisible="{Binding HasSelectedTask}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="5">
                    <TextBlock Text="{Binding SelectedTask.Title, FallbackValue=''}" FontWeight="SemiBold" />
                    <ProgressBar Value="{Binding SelectedTask.Progress, FallbackValue=0}" IsIndeterminate="{Binding SelectedTask.IsIndeterminate, FallbackValue=True}" Height="4" MinWidth="0" />
                    <TextBlock Text="{Binding SelectedTask.Detail, FallbackValue=''}" Classes="caption" FontSize="12" />
                  </StackPanel>
                  <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Content="取消" Command="{Binding SelectedTask.CancelCommand, FallbackValue={x:Null}}" />
                </Grid>
              </Border>

              <!-- Live performance (from the regular poll) -->
              <Grid ColumnDefinitions="*,12,*,12,*" Margin="0,0,0,12">
                <Border Classes="group perf" Margin="0">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <c:IconView Data="{StaticResource I.Gauge}" Width="15" Height="15" Foreground="{DynamicResource App.SubText}" />
                      <TextBlock Grid.Column="1" Text="CPU 使用率" Classes="caption" Margin="6,0,0,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).PerfWindowText}" Classes="caption" FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding CpuUsageText}" Classes="metric" />
                    <c:Sparkline Height="46" Values="{Binding Perf.CpuSeries}" Maximum="100" Stroke="{DynamicResource App.Accent}" GridBrush="{DynamicResource App.Border}"
                                 AutomationProperties.Name="CPU 使用率趋势图" />
                    <TextBlock Text="{Binding Perf.CpuStatsText}" Classes="caption" FontSize="11.5" IsVisible="{Binding HasLivePerf}" />
                    <TextBlock Text="{Binding CpuUsageSub}" Classes="caption" FontSize="11.5" IsVisible="{Binding !HasLivePerf}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="group perf" Margin="0">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*">
                      <c:IconView Data="{StaticResource I.Memory}" Width="15" Height="15" Foreground="{DynamicResource App.SubText}" />
                      <TextBlock Grid.Column="1" Text="已分配内存" Classes="caption" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding MemoryAssignedShort}" Classes="metric" />
                    <c:Sparkline Height="46" Values="{Binding Perf.MemorySeries}" Maximum="{Binding Perf.MemoryMax}" Stroke="#8764B8" GridBrush="{DynamicResource App.Border}"
                                 AutomationProperties.Name="内存趋势图" />
                    <TextBlock Text="{Binding MemoryUsageSub}" Classes="caption" FontSize="11.5" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="4" Classes="group perf" Margin="0">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*">
                      <c:IconView Data="{StaticResource I.Clock}" Width="15" Height="15" Foreground="{DynamicResource App.SubText}" />
                      <TextBlock Grid.Column="1" Text="运行时间" Classes="caption" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding UptimeText}" Classes="metric" />
                    <TextBlock Text="{Binding UptimeSub}" Classes="caption" FontSize="11.5" Margin="0,4,0,0" />
                    <Rectangle Height="1" Fill="{DynamicResource App.Border}" Margin="0,8,0,6" />
                    <Grid ColumnDefinitions="Auto,*">
                      <c:IconView Data="{StaticResource I.Checkpoint}" Width="14" Height="14" Foreground="{DynamicResource App.SubText}" />
                      <TextBlock Grid.Column="1" Text="{Binding CheckpointText, StringFormat='检查点：{0}'}" Classes="caption" Margin="6,0,0,0" />
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- Summary -->
              <Border Classes="group">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock Text="概要" Classes="section" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="tool small" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditSettingsCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <c:IconView Data="{StaticResource I.Settings}" Width="14" Height="14" />
                        <TextBlock Text="更改设置…" FontSize="12" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <Grid ColumnDefinitions="110,*,110,*">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="k" Text="操作系统" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="v" Text="{Binding OsText}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="k" Text="代数" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Classes="v" Text="{Binding GenerationText}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="k" Text="处理器" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="v" Text="{Binding CpuText}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="k" Text="启动内存" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Classes="v" Text="{Binding MemoryText}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="k" Text="虚拟硬盘" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="v" Text="{Binding DiskText}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Classes="k" Text="网络 / IP" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Classes="v" ToolTip.Tip="{Binding GuestIp}">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} · {1}">
                          <Binding Path="SwitchDisplay" />
                          <Binding Path="GuestIpDisplay" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="k" Text="DVD 驱动器" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="v" Text="{Binding IsoDisplay}" ToolTip.Tip="{Binding DvdPath}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Classes="k" Text="安全启动" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Classes="v" Text="{Binding SecureBootText}" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="k" Text="创建时间" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Classes="v" Text="{Binding CreationText}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Classes="k" Text="配置版本" />
                    <TextBlock Grid.Row="4" Grid.Column="3" Classes="v" Text="{Binding Version}" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Checkpoints -->
              <Border Classes="group" DataContext="{Binding $parent[Window].DataContext}" x:DataType="vm:MainViewModel">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding SelectedVm.CheckpointText, StringFormat='检查点（{0}）', FallbackValue='检查点'}" Classes="section" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                      <Button Classes="tool small" Command="{Binding CreateCheckpointCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <c:IconView Data="{StaticResource I.Add}" Width="13" Height="13" StrokeThickness="2" />
                          <TextBlock Text="创建" FontSize="12" />
                        </StackPanel>
                      </Button>
                      <Button Classes="tool small" Command="{Binding ApplyCheckpointCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <c:IconView Data="{StaticResource I.Reset}" Width="13" Height="13" />
                          <TextBlock Text="应用" FontSize="12" />
                        </StackPanel>
                      </Button>
                      <Button Classes="tool small" Command="{Binding DeleteCheckpointCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <c:IconView Data="{StaticResource I.Delete}" Width="13" Height="13" />
                          <TextBlock Text="删除" FontSize="12" />
                        </StackPanel>
                      </Button>
                      <Button Classes="tool small" Command="{Binding RefreshCheckpointsCommand}" ToolTip.Tip="刷新检查点" AutomationProperties.Name="刷新检查点">
                        <c:IconView Data="{StaticResource I.Refresh}" Width="13" Height="13" />
                      </Button>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,160,90" Margin="8,4,8,0">
                    <TextBlock Text="名称" Classes="caption" />
                    <TextBlock Grid.Column="1" Text="创建时间" Classes="caption" />
                    <TextBlock Grid.Column="2" Text="类型" Classes="caption" />
                  </Grid>
                  <Rectangle Height="1" Fill="{DynamicResource App.Border}" />
                  <Panel MinHeight="44">
                    <TreeView Classes="cptree" x:Name="CheckpointTreeView" ItemsSource="{Binding CheckpointTree}" SelectedItem="{Binding SelectedCheckpointNode}" MaxHeight="240"
                              IsVisible="{Binding HasCheckpoints}" AutomationProperties.Name="检查点树">
                      <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="m:CheckpointNode" ItemsSource="{Binding Children}">
                          <Grid ColumnDefinitions="Auto,*,160,90" Background="Transparent">
                            <c:IconView Data="{StaticResource I.Checkpoint}" Width="14" Height="14" Margin="0,0,8,0" Foreground="{DynamicResource App.SubText}"
                                        IsVisible="{Binding !IsNowMarker}" />
                            <c:IconView Data="{StaticResource I.Play}" Width="12" Height="12" Margin="1,0,9,0" Foreground="{DynamicResource App.Accent}"
                                        IsVisible="{Binding IsNowMarker}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                         Classes.now="{Binding IsNowMarker}" Classes.current="{Binding IsCurrent}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding CreationText}" Classes="caption" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding TypeText}" Classes="caption" VerticalAlignment="Center" />
                          </Grid>
                        </TreeDataTemplate>
                      </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock Text="暂无检查点。点击「创建」保存虚拟机当前状态，之后可随时恢复。" Classes="caption" Margin="8,12"
                               IsVisible="{Binding ShowNoCheckpoints}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CheckpointError}" Classes="error" Margin="8,12"
                               IsVisible="{Binding CheckpointError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Top" IsVisible="{Binding IsLoadingCheckpoints}" />
                  </Panel>
                </StackPanel>
              </Border>

              <!-- Storage -->
              <Border Classes="group">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock Text="存储路径" Classes="section" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                      <Button Classes="tool small" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ResizeDiskCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <c:IconView Data="{StaticResource I.Disk}" Width="14" Height="14" />
                          <TextBlock Text="扩容磁盘…" FontSize="12" />
                        </StackPanel>
                      </Button>
                      <Button Classes="tool small" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenVmFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <c:IconView Data="{StaticResource I.Folder}" Width="14" Height="14" />
                          <TextBlock Text="打开文件夹" FontSize="12" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto">
                    <TextBlock Classes="k" Text="虚拟机配置" />
                    <SelectableTextBlock Grid.Column="1" Classes="v" Text="{Binding Path}" />
                    <TextBlock Grid.Row="1" Classes="k" Text="虚拟硬盘" />
                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="v" Text="{Binding VhdPath}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Grid>
    </Panel>
  </DockPanel>
</Window>
