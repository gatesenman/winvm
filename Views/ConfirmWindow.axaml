<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WinVM.Controls"
        x:Class="WinVM.Views.ConfirmWindow"
        Title="WinVM" Icon="/Assets/winvm.ico"
        Width="480" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="footer">
      <Grid ColumnDefinitions="*,Auto">
      <Button x:Name="CopyButton" Content="复制详细信息" IsVisible="False" Click="OnCopy" HorizontalAlignment="Left" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="ConfirmButton" Classes="dlg accent" Content="确定" IsDefault="True" Click="OnConfirm" />
        <Button x:Name="CancelButton" Classes="dlg" Content="取消" IsCancel="True" Click="OnCancel" />
      </StackPanel>
      </Grid>
    </Border>
    <Grid ColumnDefinitions="Auto,*" Margin="24,22,24,22">
      <Border x:Name="IconHost" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top" Margin="0,0,16,0"
              Background="{DynamicResource App.SurfaceAlt}">
        <c:IconView x:Name="Glyph" Data="{StaticResource I.Info}" Width="22" Height="22" Foreground="{DynamicResource App.Accent}" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="10">
        <TextBlock x:Name="TitleText" Classes="dlgTitle" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="20" />
        <CheckBox x:Name="OptionCheck" IsVisible="False" Margin="0,4,0,0" />
        <StackPanel x:Name="DetailPanel" IsVisible="False" Spacing="6" Margin="0,4,0,0">
          <TextBlock Text="详细说明" Classes="section" />
          <Border Classes="warn" Padding="12,10">
            <ScrollViewer MaxHeight="280">
              <SelectableTextBlock x:Name="DetailText" TextWrapping="Wrap" LineHeight="20" />
            </ScrollViewer>
          </Border>
        </StackPanel>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
