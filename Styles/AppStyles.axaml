<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WinVM.Controls">

  <Style Selector=":is(Window)">
    <Setter Property="FontFamily" Value="{StaticResource App.Font}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource App.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>

  <!-- Typography -->
  <Style Selector=":is(TextBlock).h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).dlgTitle">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).section">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource App.SubText}" />
  </Style>
  <Style Selector=":is(TextBlock).k">
    <Setter Property="Foreground" Value="{DynamicResource App.SubText}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,5,12,5" />
  </Style>
  <Style Selector="TextBlock.v, SelectableTextBlock.v">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,5,0,5" />
  </Style>
  <Style Selector=":is(TextBlock).formLabel">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,16,0" />
  </Style>
  <Style Selector=":is(TextBlock).error">
    <Setter Property="Foreground" Value="{DynamicResource App.Danger}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.dlg">
    <Setter Property="MinWidth" Value="92" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource App.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource App.OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource App.OnAccent}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource App.OnAccent}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource App.Danger}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.DangerHover}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Danger}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Command-bar buttons (icon + text, flat) -->
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="Button.tool /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Pressed}" />
  </Style>
  <Style Selector="Button.tool:disabled">
    <Setter Property="Opacity" Value="0.38" />
  </Style>
  <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="Rectangle.vsep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="Fill" Value="{DynamicResource App.BorderStrong}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Menu bar -->
  <Style Selector="Menu.bar">
    <Setter Property="Background" Value="{DynamicResource App.Chrome}" />
    <Setter Property="Padding" Value="4,1" />
  </Style>
  <Style Selector="Menu.bar > MenuItem">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <!-- Panels -->
  <Style Selector="Border.group">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style Selector="Border.footer">
    <Setter Property="Background" Value="{DynamicResource App.Footer}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="24,16" />
  </Style>
  <Style Selector="Border.warn">
    <Setter Property="Background" Value="{DynamicResource Warn.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Warn.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <Style Selector="Border.perf">
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Toasts -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1,1,1,1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="BoxShadow" Value="0 6 18 0 #33000000" />
  </Style>
  <Style Selector="Border.toast.success"><Setter Property="BorderBrush" Value="{StaticResource Dot.Running}" /></Style>
  <Style Selector="Border.toast.warning"><Setter Property="BorderBrush" Value="#D18A00" /></Style>
  <Style Selector="Border.toast.error"><Setter Property="BorderBrush" Value="{DynamicResource App.Danger}" /></Style>

  <!-- Hyperlink-like button -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource App.AccentHover}" />
  </Style>

  <!-- Gallery cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,0,10,10" />
  </Style>
  <Style Selector="Border.mono">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource Os.Linux}" />
  </Style>
  <Style Selector="Border.mono.windows"><Setter Property="Background" Value="{StaticResource Os.Windows}" /></Style>
  <Style Selector="Border.mono TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- State chip -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="9,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Chip.Off}" />
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Chip.OffText}" />
  </Style>
  <Style Selector="Border.chip.running"><Setter Property="Background" Value="{DynamicResource Chip.Running}" /></Style>
  <Style Selector="Border.chip.running > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Chip.RunningText}" /></Style>
  <Style Selector="Border.chip.paused"><Setter Property="Background" Value="{DynamicResource Chip.Paused}" /></Style>
  <Style Selector="Border.chip.paused > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Chip.PausedText}" /></Style>
  <Style Selector="Border.chip.saved"><Setter Property="Background" Value="{DynamicResource Chip.Saved}" /></Style>
  <Style Selector="Border.chip.saved > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Chip.SavedText}" /></Style>

  <!-- Status dot -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="Fill" Value="{StaticResource Dot.Off}" />
  </Style>
  <Style Selector="Ellipse.dot.running"><Setter Property="Fill" Value="{StaticResource Dot.Running}" /></Style>
  <Style Selector="Ellipse.dot.paused"><Setter Property="Fill" Value="{StaticResource Dot.Paused}" /></Style>
  <Style Selector="Ellipse.dot.saved"><Setter Property="Fill" Value="{StaticResource Dot.Saved}" /></Style>
  <Style Selector="Ellipse.dot.transient"><Setter Property="Fill" Value="{StaticResource Dot.Transient}" /></Style>
  <Style Selector="Ellipse.dot.bad"><Setter Property="Fill" Value="{DynamicResource App.Danger}" /></Style>

  <!-- OS badge -->
  <Style Selector="Border.os">
    <Setter Property="Background" Value="{StaticResource Os.Unknown}" />
  </Style>
  <Style Selector="Border.os.windows"><Setter Property="Background" Value="{StaticResource Os.Windows}" /></Style>
  <Style Selector="Border.os.linux"><Setter Property="Background" Value="{StaticResource Os.Linux}" /></Style>
  <Style Selector="Border.os c|IconView">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Filled" Value="True" />
  </Style>

  <!-- VM list -->
  <Style Selector="ListBox.vmlist">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="ListBox.vmlist ListBoxItem">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="ListBox.vmlist ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Hover}" />
  </Style>
  <Style Selector="ListBox.vmlist ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Pressed}" />
  </Style>
  <Style Selector="ListBox.vmlist ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Hover}" />
  </Style>
  <Style Selector="ListBox.vmlist ListBoxItem Border.pill">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ListBox.vmlist ListBoxItem:selected Border.pill">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- Checkpoint list -->
  <!-- 1.5 checkpoint tree -->
  <Style Selector="TreeView.cptree">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TreeView.cptree TreeViewItem">
    <Setter Property="IsExpanded" Value="True" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TreeView.cptree TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="TreeView.cptree TextBlock.now">
    <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TreeView.cptree TextBlock.current">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBox.cplist">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.cplist ListBoxItem">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="GridSplitter.split">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="5" />
    <Setter Property="Margin" Value="-3,0,-2,0" />
  </Style>
</Styles>
