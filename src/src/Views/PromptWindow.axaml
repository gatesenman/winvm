<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WinVM.Views.PromptWindow"
        Title="WinVM" Icon="/Assets/winvm.ico"
        Width="480" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="footer">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="ConfirmButton" Classes="dlg accent" Content="确定" IsDefault="True" Click="OnConfirm" />
        <Button Classes="dlg" Content="取消" IsCancel="True" Click="OnCancel" />
      </StackPanel>
    </Border>
    <StackPanel Margin="24,22,24,22" Spacing="10">
      <TextBlock x:Name="TitleText" Classes="dlgTitle" TextWrapping="Wrap" />
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
      <TextBox x:Name="InputBox" Margin="0,4,0,0" />
      <Grid x:Name="NumberRow" ColumnDefinitions="180,Auto" IsVisible="False" Margin="0,4,0,0">
        <NumericUpDown x:Name="NumberBox" Increment="1" FormatString="0" />
        <TextBlock x:Name="UnitText" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" />
      </Grid>
      <TextBlock x:Name="ErrorText" Classes="error" IsVisible="False" />
      <TextBlock x:Name="HintText" Classes="caption" TextWrapping="Wrap" IsVisible="False" />
    </StackPanel>
  </DockPanel>
</Window>
