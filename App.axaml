<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:WinVM.Controls"
             x:Class="WinVM.App"
             Name="WinVM"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="App.Background" Color="#F3F3F3" />
          <SolidColorBrush x:Key="App.Chrome" Color="#F9F9F9" />
          <SolidColorBrush x:Key="App.Sidebar" Color="#F0F2F5" />
          <SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
          <SolidColorBrush x:Key="App.SurfaceAlt" Color="#F7F8FA" />
          <SolidColorBrush x:Key="App.Border" Color="#E3E5E8" />
          <SolidColorBrush x:Key="App.BorderStrong" Color="#D1D4D8" />
          <SolidColorBrush x:Key="App.Text" Color="#1B1B1B" />
          <SolidColorBrush x:Key="App.SubText" Color="#5F6368" />
          <SolidColorBrush x:Key="App.Hover" Color="#0F000000" />
          <SolidColorBrush x:Key="App.Pressed" Color="#18000000" />
          <SolidColorBrush x:Key="App.Accent" Color="#0067C0" />
          <SolidColorBrush x:Key="App.AccentHover" Color="#1975C5" />
          <SolidColorBrush x:Key="App.OnAccent" Color="#FFFFFF" />
          <SolidColorBrush x:Key="App.Danger" Color="#C42B1C" />
          <SolidColorBrush x:Key="App.DangerHover" Color="#B02718" />
          <SolidColorBrush x:Key="App.StatusBar" Color="#ECEEF1" />
          <SolidColorBrush x:Key="App.Footer" Color="#F3F3F3" />
          <SolidColorBrush x:Key="Chip.Running" Color="#DFF6DD" />
          <SolidColorBrush x:Key="Chip.RunningText" Color="#0F7B0F" />
          <SolidColorBrush x:Key="Chip.Paused" Color="#FFF4CE" />
          <SolidColorBrush x:Key="Chip.PausedText" Color="#8A5300" />
          <SolidColorBrush x:Key="Chip.Saved" Color="#E5F1FB" />
          <SolidColorBrush x:Key="Chip.SavedText" Color="#005A9E" />
          <SolidColorBrush x:Key="Chip.Off" Color="#EDEDED" />
          <SolidColorBrush x:Key="Chip.OffText" Color="#5F6368" />
          <SolidColorBrush x:Key="Warn.Background" Color="#FFF4CE" />
          <SolidColorBrush x:Key="Warn.Border" Color="#F2D58A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="App.Background" Color="#202020" />
          <SolidColorBrush x:Key="App.Chrome" Color="#2B2B2B" />
          <SolidColorBrush x:Key="App.Sidebar" Color="#1C1C1C" />
          <SolidColorBrush x:Key="App.Surface" Color="#272727" />
          <SolidColorBrush x:Key="App.SurfaceAlt" Color="#2E2E2E" />
          <SolidColorBrush x:Key="App.Border" Color="#383838" />
          <SolidColorBrush x:Key="App.BorderStrong" Color="#454545" />
          <SolidColorBrush x:Key="App.Text" Color="#F2F2F2" />
          <SolidColorBrush x:Key="App.SubText" Color="#A8A8A8" />
          <SolidColorBrush x:Key="App.Hover" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="App.Pressed" Color="#0AFFFFFF" />
          <SolidColorBrush x:Key="App.Accent" Color="#4CC2FF" />
          <SolidColorBrush x:Key="App.AccentHover" Color="#62CAFF" />
          <SolidColorBrush x:Key="App.OnAccent" Color="#000000" />
          <SolidColorBrush x:Key="App.Danger" Color="#E5584A" />
          <SolidColorBrush x:Key="App.DangerHover" Color="#EF6B5E" />
          <SolidColorBrush x:Key="App.StatusBar" Color="#1A1A1A" />
          <SolidColorBrush x:Key="App.Footer" Color="#202020" />
          <SolidColorBrush x:Key="Chip.Running" Color="#1F3A1F" />
          <SolidColorBrush x:Key="Chip.RunningText" Color="#6CCB5F" />
          <SolidColorBrush x:Key="Chip.Paused" Color="#3D3218" />
          <SolidColorBrush x:Key="Chip.PausedText" Color="#FCE100" />
          <SolidColorBrush x:Key="Chip.Saved" Color="#17324A" />
          <SolidColorBrush x:Key="Chip.SavedText" Color="#60CDFF" />
          <SolidColorBrush x:Key="Chip.Off" Color="#333333" />
          <SolidColorBrush x:Key="Chip.OffText" Color="#B5B5B5" />
          <SolidColorBrush x:Key="Warn.Background" Color="#433519" />
          <SolidColorBrush x:Key="Warn.Border" Color="#6B5420" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <SolidColorBrush x:Key="Dot.Running" Color="#13A10E" />
      <SolidColorBrush x:Key="Dot.Paused" Color="#F7A600" />
      <SolidColorBrush x:Key="Dot.Saved" Color="#2B88D8" />
      <SolidColorBrush x:Key="Dot.Off" Color="#8A8A8A" />
      <SolidColorBrush x:Key="Dot.Transient" Color="#8764B8" />
      <SolidColorBrush x:Key="Os.Windows" Color="#0078D4" />
      <SolidColorBrush x:Key="Os.Linux" Color="#E95420" />
      <SolidColorBrush x:Key="Os.Unknown" Color="#6B7280" />

      <FontFamily x:Key="App.Font">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei, PingFang SC, Noto Sans CJK SC, Noto Sans, sans-serif</FontFamily>

